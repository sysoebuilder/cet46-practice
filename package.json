{
  "name": "cet-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:h5": "vite --host 0.0.0.0",
    "build:h5": "vite build",
    "preview:h5": "vite preview --config vite.preview.config.mjs",
    "build:app": "node scripts/build-native-ui.mjs",
    "dev:app": "node scripts/build-native-ui.mjs --watch",
    "check:app": "node scripts/check-native-package.mjs && node scripts/check-native-webview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@vueuse/core": "^12.8.2",
    "motion-v": "^2.8.0",
    "vue": "^3.4.21",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "5.2.4",
    "rollup": "4.14.3",
    "vite": "5.2.8"
  }
}
